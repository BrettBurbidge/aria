generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  spotify_id    String        @unique
  display_name  String?
  email         String?
  image_url     String?
  created_at    DateTime      @default(now()) @db.Timestamptz(6)
  mood_sessions MoodSession[]
  spotify_token SpotifyToken?

  @@map("users")
}

model SpotifyToken {
  user_id       String   @id @db.Uuid
  access_token  String
  refresh_token String
  expires_at    DateTime @db.Timestamptz(6)
  user          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("spotify_tokens")
}

model MoodSession {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String              @db.Uuid
  mood_input          String
  parsed_params       Json?
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  generated_playlists GeneratedPlaylist[]
  user                User                @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([created_at(sort: Desc)])
  @@map("mood_sessions")
}

model GeneratedPlaylist {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id          String      @db.Uuid
  spotify_playlist_id String?
  tracks              Json
  created_at          DateTime    @default(now()) @db.Timestamptz(6)
  mood_session        MoodSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@index([session_id])
  @@map("generated_playlists")
}

model CachedTrack {
  spotify_id     String   @id
  name           String
  artist         String
  audio_features Json?
  lastfm_tags    Json?
  cached_at      DateTime @default(now()) @db.Timestamptz(6)

  @@map("cached_tracks")
}
