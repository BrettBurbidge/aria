# ─── Anthropic ────────────────────────────────────────────────────────────────
# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── Spotify ──────────────────────────────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
# Required scopes: playlist-modify-public playlist-modify-private user-read-email
SPOTIFY_CLIENT_ID=3
SPOTIFY_CLIENT_SECRET=d33
# Must match exactly what you set in your Spotify app's Redirect URIs
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/api/auth/callback

# ─── Last.fm ──────────────────────────────────────────────────────────────────
# Free API key from https://www.last.fm/api/account/create
LASTFM_API_KEY=693
LASTFM_SHARED_SECRET=fb0c
LASTFM_REGISTERED_TO=bb

# ─── Genius ───────────────────────────────────────────────────────────────────
# Create a client at https://genius.com/api-clients
GENIUS_ACCESS_TOKEN=PeiGePIN
GENIUS_CLIENT_ID=he
GENIUS_CLIENT_SECRET=o
GENIUS_REDIRECT_URI=https://localhost:5173
# ─── Supabase ─────────────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
PUBLIC_SUPABASE_URL=postgresql:
PUBLIC_SUPABASE_ANON_KEY=ey5
SUPABASE_SERVICE_ROLE_KEY=ey

# ─── Database (Prisma) ────────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL  → use the "Transaction" pooler URL (port 6543) for runtime queries
# DIRECT_URL    → use the direct connection (port 5432) for migrations (prisma migrate)
#
# Both follow this pattern:
#   postgresql://postgres.[project-ref]:[password]@[host]:[port]/postgres
DATABASE_URL=postgresql://postgres.
DIRECT_URL=postgresql://postgres.
